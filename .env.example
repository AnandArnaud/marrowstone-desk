# Database. Development uses a local SQLite file; production uses MySQL 8 (see docs/adr/0001-database.md).
DB_CLIENT=sqlite
DATABASE_URL=file:./data/marrowstone.db
# Production example:
# DB_CLIENT=mysql
# DATABASE_URL=mysql://desk:password@db.internal:3306/marrowstone

# Session cookies are signed with this. Any long random string.
SESSION_SECRET=change-me-in-production

# jobs/summarize.ts and lib/assistant.ts
OPENAI_API_KEY=

# Links in outbound email. Mail is posted to MAIL_RELAY_URL when set, else appended to data/outbox.jsonl.
APP_URL=http://localhost:3000
MAIL_RELAY_URL=
